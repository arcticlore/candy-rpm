{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  › " },
  "modules": [
    "title",
    { "type": "os", "format": "{pretty-name} ({arch})" },
    "kernel",
    { "type": "packages", "format": "{} (pacman-dnf hybrid vibes)" },
    "shell",
    { "type": "terminal", "format": "{} on {}" },
    "cpu", "gpu", "memory", "disk", "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "🍬" }
  ]
}
